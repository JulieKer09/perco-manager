{
  "name": "perco-dofus",
  "version": "1.0.0",
  "description": "Gestionnaire de percepteurs Dofus",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "pngjs": "^7.0.0"
  },
  "build": {
    "appId": "com.perco.dofus",
    "productName": "Perco Dofus",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "models/**/*",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "icon": "renderer/assets/icons/Logo.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "installerIcon": "renderer/assets/icons/Logo.ico",
      "uninstallerIcon": "renderer/assets/icons/Logo.ico"
    }
  }
}
